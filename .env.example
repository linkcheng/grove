# ═══════════════════════════════════════════════════════════════════════
# GROVE 运行时配置
# ═══════════════════════════════════════════════════════════════════════
# 每个进程只使用一个角色，并为该角色配置最小权限数据库账号。
#
# 部署角色（GROVE_ROLE）决定启动行为和权限边界：
#   api                      → FastAPI HTTP 服务（submit/query only）
#   runtime_worker           → 非 HTTP worker loop（claim → Graph → checkpoint → finish_delivery）
#   projection_reconciliation → 过期 lease 对账
#   offline_governance       → 离线评测与治理

# ── 角色与环境 ──────────────────────────────────────────────────────────

# 用途：选择本进程部署角色；要求：必填；适用：api/runtime_worker/projection_reconciliation/offline_governance 进程；敏感：否。
GROVE_ROLE=api

# 用途：选择运行环境并约束认证模式；要求：可选（默认 development）；适用：所有角色；敏感：否。
GROVE_APP_ENV=development

# 用途：设置时间显示与日志时区；要求：可选（默认 Asia/Shanghai）；适用：所有角色；敏感：否。
GROVE_APP_TIMEZONE=Asia/Shanghai

# 用途：设置日志级别（DEBUG/INFO/WARNING/ERROR）；要求：可选（默认 INFO）；适用：所有角色；敏感：否。
GROVE_LOG_LEVEL=INFO

# ── 认证 ────────────────────────────────────────────────────────────────

# fixture 仅 development/test/conformance/integration，production/staging fail closed。
# gateway 模式由可信反向代理注入身份头（X-Grove-Tenant-ID、X-Grove-Principal-ID、可选 X-Grove-Principal-Kind），
# 并以共享密钥 GROVE_GATEWAY_AUTH_TOKEN（至少 16 字符、无空白）证明头来源；客户端自报头一律拒绝。
# 用途：选择认证模式（disabled、fixture 或 gateway）；要求：可选（默认 disabled）；适用：所有角色；敏感：否。
GROVE_AUTH_MODE=disabled

# 用途：gateway 模式与可信网关共享的认证密钥；要求：GROVE_AUTH_MODE=gateway 时必填（>=16 字符）；适用：api 角色；敏感：是。
GROVE_GATEWAY_AUTH_TOKEN=__REPLACE_WITH_GATEWAY_SHARED_TOKEN__

# ── 数据库 ──────────────────────────────────────────────────────────────

# 示例中的数据库密码只是占位符，不能作为真实凭据使用。
# 用途：连接对应角色的 PostgreSQL 数据库；要求：可选（开发默认，生产/各角色应显式配置最小权限 URL）；适用：api 或对应 runtime_worker/projection_reconciliation/offline_governance 进程；敏感：是。
GROVE_DATABASE_URL=postgresql+psycopg://grove_api:__REPLACE_WITH_API_DB_PASSWORD__@localhost:5432/grove

# 用途：设置当前角色独立连接池的常驻连接上限；要求：可选（默认 10，范围 [1,50]）；适用：每个运行角色独立配置；敏感：否。
GROVE_DATABASE_POOL_SIZE=10

# 用途：设置当前角色连接池的临时溢出连接上限；要求：可选（默认 10，范围 [0,50]）；适用：每个运行角色独立配置；敏感：否。
GROVE_DATABASE_MAX_OVERFLOW=10

# 用途：限制从当前角色连接池取得连接的等待时间；要求：可选（默认 5 秒，范围 (0,30]）；适用：每个运行角色独立配置；敏感：否。
GROVE_DATABASE_POOL_TIMEOUT_SECONDS=5.0

# ── Runtime Worker ──────────────────────────────────────────────────────

# 用途：runtime_worker 进程绑定的租户 ID；要求：可选（默认 default，单租户部署）；适用：runtime_worker 角色；敏感：否。
GROVE_WORKER_TENANT_ID=default

# 用途：runtime_worker 进程的唯一标识（claim/lease/fence 追踪）；要求：可选（默认 grove-worker-1）；适用：runtime_worker 角色；敏感：否。
GROVE_WORKER_ID=grove-worker-1

# 用途：runtime build 的 sha256 hash（worker 只 claim 匹配此 hash 的 command）；要求：runtime_worker 角色必填；适用：runtime_worker 角色；敏感：否。
GROVE_RUNTIME_BUILD_HASH=

# 用途：启用 production inference composition（disabled/production）；要求：可选（默认 disabled）；适用：runtime_worker；敏感：否。
GROVE_INFERENCE_MODE=disabled

# fixture submit 绑定的执行内核：conformance（确定性图，默认）或 asset_risk（AssetRisk Profile 图，WS-6 D）。
# 用途：选择 fixture spec 的 graph binding 变体；要求：可选（默认 conformance）；适用：api 角色；敏感：否。
GROVE_FIXTURE_GRAPH_BINDING=conformance

# ── 构建与镜像标识 ──────────────────────────────────────────────────────

# 用途：记录应用镜像标识；要求：可选（默认 not_built）；适用：构建/发布校验与所有运行角色；敏感：否。
GROVE_APP_IMAGE_ID=not_built

# 用途：记录 PostgreSQL 镜像标识；要求：可选（默认 not_resolved）；适用：构建/发布校验与所有运行角色；敏感：否。
GROVE_POSTGRES_IMAGE_ID=not_resolved

# ── 基础设施 ────────────────────────────────────────────────────────────

# 用途：限制就绪探针等待时间；要求：可选（默认 2.0 秒，范围 (0,10]）；适用：api/基础设施探针；敏感：否。
GROVE_READINESS_TIMEOUT_SECONDS=2.0

# ═══════════════════════════════════════════════════════════════════════
# AI Gateway（runtime_worker production inference v2）
# ═══════════════════════════════════════════════════════════════════════
# 仅 runtime_worker composition root 消费本组变量；Graph/Node 不得读取。

# 用途：配置 OpenAI-compatible AI Gateway 地址；要求：条件必填（G2 production adapter 启用时）；适用：runtime_worker G2 adapter；敏感：否。
AI_GATEWAY_URL=https://gateway.example.invalid/v1

# 用途：提供 AI Gateway 认证凭据；要求：条件必填（G2 production adapter 启用时）；适用：runtime_worker G2 adapter；敏感：是。
AI_GATEWAY_API_KEY=__REPLACE_WITH_AI_GATEWAY_API_KEY__

# 用途：指定 AI Gateway 精确模型 ID；要求：条件必填（G2 production adapter 启用时）；适用：runtime_worker G2 adapter；敏感：否。
AI_GATEWAY_MODEL=doubao-seed-2-0-pro-260215

# 用途：选择部署 secret store 中的凭据槽位；要求：production inference 必填且必须等于 ProviderBindingManifest；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_CREDENTIAL_SLOT_ID=gateway-primary

# 用途：提供 cleanroom verifier 的只读 authority 目录；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_AUTHORITY_DIR=/run/grove/release-authority

# 用途：提供签发的 CoreReleaseIdentity 候选文件；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_CANDIDATE_PATH=/run/grove/release/core-release-identity.json

# 用途：提供 issuer 签发的 expected facts 文件；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_EXPECTED_FACTS_PATH=/run/grove/release/core-release-expected-facts.json

# 用途：提供 expected facts 的 issuer signature；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_SIGNATURE_PATH=/run/grove/release/core-release-expected-facts.signature.json

# 用途：提供外部签发且由 candidate.execution.provider hash 绑定的 ProviderBindingManifest；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_PROVIDER_MANIFEST_PATH=/run/grove/release/provider-binding-manifest.json

# 用途：固定 cleanroom root public key hash；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_ROOT_PUBLIC_KEY_SHA256=

# 用途：固定 cleanroom trust policy 精确 ref/version/hash；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_POLICY_REF=trust-policy.core@2026.08.13
# 用途：固定 cleanroom trust policy version；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_POLICY_VERSION=v1
# 用途：固定 cleanroom trust policy sha256；要求：production inference 必填；适用：runtime_worker production inference；敏感：否。
AI_GATEWAY_RELEASE_POLICY_SHA256=

# ═══════════════════════════════════════════════════════════════════════
# 集成测试与发布工具覆盖项
# ═══════════════════════════════════════════════════════════════════════
# 这些变量不属于应用运行时清单，只在对应命令/脚本作用域临时设置。

# 用途：覆盖迁移脚本使用的 PostgreSQL URL；要求：可选（默认由具体脚本处理）；适用：migration/integration tooling 临时作用域；敏感：是。
# GROVE_MIGRATION_DATABASE_URL=postgresql+psycopg://grove_migration:__REPLACE_WITH_MIGRATION_DB_PASSWORD__@localhost:5432/grove

# 用途：覆盖 integration tests 的 API 基地址；要求：可选（默认 http://127.0.0.1:8000）；适用：integration tooling 临时作用域；敏感：否。
# GROVE_API_BASE_URL=http://127.0.0.1:8000

# 用途：指定 reverse validation 使用的 Manifest 路径；要求：可选（默认 ci-evidence/runtime-build-manifest.json）；适用：reverse validation 临时作用域；敏感：否。
# GROVE_REVERSE_MANIFEST=ci-evidence/runtime-build-manifest.json

# 值 1 会跳过 integration script 顶层执行与 cleanup，普通用户不要设置。
# 用途：启用 integration script library mode；要求：可选（默认 0）；适用：脚本内部 library 调用；敏感：否。
# GROVE_INTEGRATION_LIBRARY=0

# 修改 Compose project 名称会改变资源命名与清理范围，请勿指向已有用户项目。
# 用途：覆盖 Docker Compose project 名称；要求：可选（默认 grove-ws0-test）；适用：integration/cleanroom 临时作用域；敏感：否。
# COMPOSE_PROJECT_NAME=grove-ws0-test

# 值 1 可能删除该临时 project 的 volumes；不得用于或暗示操作用户数据。
# 用途：控制 cleanroom volume 清理；要求：可选（默认 0，仅临时 cleanroom）；适用：临时 cleanroom compose project；敏感：否。
# CLEANROOM_REMOVE_VOLUMES=0

# ── Dockerfile/脚本/compose 内部固定变量（无需用户设置）────────────────
# SOURCE_DATE_EPOCH, PGCONNECT_TIMEOUT, PGOPTIONS, POSTGRES_*
